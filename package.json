{
  "name": "feishu-wiki-sync",
  "version": "0.1.3",
  "license": "MIT",
  "description": "Obsidian plugin for bidirectional sync with Feishu Wiki documents and Markdown files",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc --noEmit && node esbuild.config.mjs production",
    "typecheck": "tsc --noEmit",
    "install:vault": "node scripts/install-to-vault.mjs",
    "check:release": "node scripts/check-release.mjs",
    "check": "npm run check:release && npm run typecheck",
    "package": "npm run check && npm run build && node scripts/package.mjs",
    "real:check": "esbuild scripts/real-check/main.ts --bundle --platform=node --format=esm --alias:obsidian=scripts/real-check/obsidian-shim.ts --outfile=scripts/real-check/run.mjs && node scripts/real-check/run.mjs",
    "preinstall:vault": "npm run build"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "esbuild": "^0.20.0",
    "obsidian": "1.13.1",
    "typescript": "^5.3.3"
  },
  "engines": {
    "node": ">=20"
  }
}
